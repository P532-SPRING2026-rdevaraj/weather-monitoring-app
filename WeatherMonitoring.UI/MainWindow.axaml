<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="WeatherMonitoring.UI.MainWindow"
        Title="WeatherMonitoring.UI">
        <StackPanel Margin="20" Spacing="10">
    <TextBlock Text="Weather Monitoring System"
               FontSize="20"
               HorizontalAlignment="Center"/>

    <TextBlock x:Name="TemperatureText"/>
    <TextBlock x:Name="HumidityText"/>
    <TextBlock x:Name="PressureText"/>

    <Button Content="Update Weather"
            Width="150"
            HorizontalAlignment="Center"
            Click="UpdateWeather_Click"/>
</StackPanel>

</Window>
